DOGIDO_BIND_HOST=127.0.0.1
DOGIDO_BIND_PORT=5055
# 呼びかけ名（うしろ named・雑談など）。player_names/manifest.json のキーと揃えると名前断片が鳴る
DOGIDO_DEFAULT_CALL_NAME=プレイヤー
DOGIDO_AUDIO_ENABLED=true
DOGIDO_DECISION_POLICY=py_trees
DOGIDO_LLM_ENABLED=true
DOGIDO_TTS_BACKEND=voicevox
DOGIDO_CUE_BACKEND=afplay
DOGIDO_VOICEVOX_URL=http://127.0.0.1:50021
DOGIDO_VOICEVOX_SPEAKER=21
# 話速プロファイル（cue mp3 には効かない。VOICEVOX speedScale）
# battle: 戦況 callout / 緊急 speech（未設定時は DOGIDO_VOICEVOX_SPEED_SCALE）
DOGIDO_VOICEVOX_SPEED_SCALE=1.0
# DOGIDO_VOICEVOX_SPEED_SCALE_BATTLE=1.0
DOGIDO_VOICEVOX_SPEED_SCALE_PEACE=0.88
DOGIDO_VOICEVOX_SPEED_SCALE_HAIKU=0.80
# TTS キャッシュ（.dogido_tmp/voicevox/cache。gitignore）。上限超過・古い順に自動削除
DOGIDO_VOICEVOX_CACHE_MAX_MB=256
DOGIDO_VOICEVOX_CACHE_MAX_AGE_DAYS=7
# TTS 読み補正（朝→ちょう 等）。auto=UniDic があれば使う / unidic / off=例外表のみ
# UniDic: pip install -e ".[tts-reading]"（fugashi + unidic-lite、~250MB）
DOGIDO_TTS_READING_ENGINE=auto
DOGIDO_CUE_AUDIO_DIR=cue_voice

# === 川柳生成方式の実環境比較（2026-08-13 一時設定）===
# 重要: 比較・開発が終わったら DOGIDO_HAIKU_INTERVAL_MS=600000（10分）へ必ず戻す。
# 現在はデータ収集のため3分。脅威・入力・発話後の30秒静寂は別に維持する。
DOGIDO_HAIKU_INTERVAL_MS=180000
DOGIDO_HAIKU_QUIET_TIME_MS=30000
# 1方式ずつ固定して比較する。自動選択はまだ行わない。
# whole_poem / three_slot / one_plus_two / two_plus_one
DOGIDO_HAIKU_GENERATION_STRATEGY=three_slot
# 初稿の後に許す再生成round数。実測用は6、設定上限は8。
DOGIDO_HAIKU_MAX_REGENERATION_ROUNDS=6
# 戦闘中断中、単独の敵が非接近・無被弾で安定してから明示再開を許す時間。
DOGIDO_WORKSHOP_LOW_THREAT_RESUME_DELAY_MS=8000

# ---------------------------------------------------------------------------
# LLM 共通
# - 判断（いつ喋る/黙る/詠む/保存する）はコード側。
#   LLM / OS AI は言い回しと、workshop の閉じた intent / findings / 一行置換 /
#   pending採否の意味抽出まで。実行・保存・CAS検証はコード側。
# - provider が local 以外なら、backend=mlx でも chat_completions 等に自動解決。
# - max_tokens 既定 72 は短い相棒セリフ用。長めの試験時だけ上げる。
# ---------------------------------------------------------------------------
DOGIDO_LLM_TIMEOUT_SEC=20
DOGIDO_LLM_MAX_TOKENS=72

# === 小さな構造化判定用の OS / 端末内 AI ===
# Apple: pip install -e ".[os-ai-apple]"（macOS 26+ / Xcode 26+ / Apple Intelligence）
# Windows/Linux: pip install -e ".[os-ai-foundry]"
# auto: macOS は Apple Intelligence → Foundry Local、Windows/Linux は Foundry Localを探し、
#       どの端末内AIも利用不可なら下記 chat route と同じモデルへ自動 fallback。
# apple / foundry / chat で固定も可能。
DOGIDO_PLATFORM_AI_PROVIDER=auto
DOGIDO_PLATFORM_AI_REFRESH_SEC=300
DOGIDO_PLATFORM_AI_TIMEOUT_SEC=8
DOGIDO_PLATFORM_AI_FAILURE_COOLDOWN_SEC=60
# Foundry は alias から端末向け CPU/GPU/NPU variant を自動選択し、定期再解決する。
DOGIDO_PLATFORM_AI_FOUNDRY_MODEL_ALIAS=qwen2.5-7b
# 初回の大容量モデル取得を無断で始めない。UIで同意を取れるまでは false。
DOGIDO_PLATFORM_AI_ALLOW_MODEL_DOWNLOAD=false

# === 既定: ローカル MLX（Apple Silicon）===
DOGIDO_LLM_BACKEND=mlx
DOGIDO_LLM_PROVIDER=local
DOGIDO_MLX_MODEL_ID=mlx-community/Qwen3.6-35B-A3B-4bit-DWQ

# === OpenAI（Chat Completions / クラウド GPT）===
# Series T 等の API クレジットを使うときの最小例。
# .env に実キーを書き、下のコメントを外して上の mlx 既定を無効化する。
#
# DOGIDO_LLM_BACKEND=chat_completions
# DOGIDO_LLM_PROVIDER=openai
# DOGIDO_LLM_MODEL=gpt-5.6-luna
# DOGIDO_LLM_API_KEY=
# （任意）試験で少し長く喋らせる:
# DOGIDO_LLM_MAX_TOKENS=512
# DOGIDO_LLM_TIMEOUT_SEC=60
#
# モデル例（名前は OpenAI 側の最新表記に合わせて差し替え）:
#   gpt-5.6-luna   … 安く速い比較用・高ボリューム向け
#   gpt-5.6-terra  … バランス型（日常・雑談・直しの品質試験）
#   gpt-5.6-sol    … フラッグシップ（フロンティア比較・コスト・レイテンシ注意）
#   gpt-5.6 / gpt-5.6-sol エイリアスもあり

# === ルート別（chat=雑談/助言、haiku=川柳）===
# 片方だけクラウド、片方はローカル、なども可。未指定キーは共通設定を継承。
#
# 例: 雑談は GPT、川柳は別モデル
# DOGIDO_LLM_CHAT_PROVIDER=openai
# DOGIDO_LLM_CHAT_MODEL=gpt-5.6-terra
# DOGIDO_LLM_CHAT_API_KEY=
# DOGIDO_LLM_CHAT_MAX_TOKENS=512
# DOGIDO_LLM_CHAT_TIMEOUT_SEC=60
#
# DOGIDO_LLM_HAIKU_PROVIDER=openai
# DOGIDO_LLM_HAIKU_MODEL=gpt-5.6-luna
# DOGIDO_LLM_HAIKU_API_KEY=
# DOGIDO_LLM_HAIKU_MAX_TOKENS=256

# === その他クラウド ===
# Chat Completions: local server
# DOGIDO_LLM_BACKEND=chat_completions
# DOGIDO_LLM_PROVIDER=local
# DOGIDO_LLM_BASE_URL=http://127.0.0.1:8080/v1
# DOGIDO_LLM_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit-DWQ
# DOGIDO_LLM_API_KEY=

# OpenRouter
# DOGIDO_LLM_BACKEND=chat_completions
# DOGIDO_LLM_PROVIDER=openrouter
# DOGIDO_LLM_MODEL=openai/gpt-5.6-luna
# DOGIDO_LLM_API_KEY=
# DOGIDO_LLM_HTTP_REFERER=https://example.com
# DOGIDO_LLM_APPLICATION_NAME=Dogido

# Claude (Anthropic Messages)
# DOGIDO_LLM_CHAT_PROVIDER=claude
# DOGIDO_LLM_CHAT_MODEL=claude-opus-5
# DOGIDO_LLM_CHAT_API_KEY=
# （他例: claude-sonnet-5 / claude-fable-5  など）

# Grok (xAI Chat Completions)
# DOGIDO_LLM_CHAT_PROVIDER=grok
# DOGIDO_LLM_CHAT_MODEL=grok-4.5
# DOGIDO_LLM_CHAT_API_KEY=

# Gemini
# DOGIDO_LLM_CHAT_PROVIDER=gemini
# DOGIDO_LLM_CHAT_MODEL=gemini-3.6-flash
# DOGIDO_LLM_CHAT_API_KEY=
# （他例: gemini-3.5-flash / gemini-3.5-flash-lite など）
