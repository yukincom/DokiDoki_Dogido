DOGIDO_BIND_HOST=127.0.0.1
DOGIDO_BIND_PORT=5055
# HTTP設定はRust本体へ渡る。省略時は共有runtime_defaults.jsonの既定値。
# DOGIDO_MAX_BATCH_SIZE=25
# DOGIDO_MAX_BODY_KB=256
# DOGIDO_HEARTBEAT_INTERVAL_MS=5000
# DOGIDO_ACCEPTED_SCHEMA_VERSION=2026-05-24
# 呼びかけ名（うしろ named・雑談など）。player_names/manifest.json のキーと揃えると名前断片が鳴る
DOGIDO_DEFAULT_CALL_NAME=プレイヤー
DOGIDO_AUDIO_ENABLED=true
DOGIDO_LLM_ENABLED=true
DOGIDO_CONVERSATION_ACTIVE_TTL_MS=300000
# 雑談後の友好・中立モブコメントは最後の入力から30秒待つ。会話保持とは別。
DOGIDO_CONVERSATION_AMBIENT_MUTE_MS=30000
# 戦闘・自動川柳で保留した話題は、再開されなければplayer turn 10件で破棄。
DOGIDO_CONVERSATION_SUSPENDED_PLAYER_TURNS=10
# 危険前5往復は、危険終了後の通常会話3turn目まで一時保持。
DOGIDO_CONVERSATION_POST_DANGER_PLAYER_TURNS=3
DOGIDO_TTS_BACKEND=voicevox
DOGIDO_VOICEVOX_URL=http://127.0.0.1:50021
DOGIDO_VOICEVOX_SPEAKER=21
# 話速プロファイル（cue mp3 には効かない。VOICEVOX speedScale）
# battle: 戦況 callout / 緊急 speech（未設定時は DOGIDO_VOICEVOX_SPEED_SCALE）
DOGIDO_VOICEVOX_SPEED_SCALE=1.0
# DOGIDO_VOICEVOX_SPEED_SCALE_BATTLE=1.0
DOGIDO_VOICEVOX_SPEED_SCALE_PEACE=0.88
DOGIDO_VOICEVOX_SPEED_SCALE_HAIKU=0.80
# TTS 読み補正（朝→ちょう 等）。auto=UniDic があれば使う / unidic / off=例外表のみ
# UniDic: pip install -e ".[tts-reading]"（fugashi + unidic-lite、~250MB）
DOGIDO_TTS_READING_ENGINE=auto
DOGIDO_CUE_AUDIO_DIR=cue_voice

# === 任意のマイクエコー除去（macOS 14.2+） ===
# 別環境への導入: bash scripts/setup_echo_capture.sh（録音しない）
# webrtc はMacの再生音全体を参照し、処理済みマイクだけを既存STTへ渡す。
# 参照音の保存・送信なし。既定は従来入力。実機確認・権限: docs/voice-echo-cancellation.md
DOGIDO_VOICE_ECHO_CANCELLATION=off
# 空欄ならmacOS既定マイク。従来のavfoundation番号とは異なる機器UID。
# DOGIDO_VOICE_ECHO_INPUT_UID=
# DOGIDO_VOICE_ECHO_DELAY_MS=0

# === 川柳生成方式 ===
# 通常の発句間隔は10分。短期比較で縮める場合も、終了後はこの値へ戻す。
# 脅威・入力・発話後の30秒静寂は別に維持する。
DOGIDO_HAIKU_INTERVAL_MS=600000
DOGIDO_HAIKU_QUIET_TIME_MS=30000
# 1方式ずつ固定して比較する。自動選択はまだ行わない。
# whole_poem / three_slot / one_plus_two / two_plus_one
DOGIDO_HAIKU_GENERATION_STRATEGY=three_slot
# 初稿の後に許す再生成round数。実測用は6、設定上限は8。
DOGIDO_HAIKU_MAX_REGENERATION_ROUNDS=6

# ---------------------------------------------------------------------------
# LLM 共通
# - 判断（いつ喋る/黙る/詠む/保存する）はコード側。
#   通常workshopは下の常駐 chat LLM が相談本文・新しい句案を生成する。
#   読み方と保存材料は必要な質問で参照し、編集結果はコードで返す。
#   分類は共通BERT。戦闘からの再開・継続は敵の警戒解除をコードで判定する。
#   OS AI分類と旧fallbackは撤去済み。実行・保存・CASもコード側。
# - 別に起動したlocalhostのChat Completions APIへ接続する。
#   モデルの読込・起動・停止はドギドでは行わない。
# - max_tokens 既定 72 は短い相棒セリフ用。長めの試験時だけ上げる。
# ---------------------------------------------------------------------------
DOGIDO_LLM_TIMEOUT_SEC=20
DOGIDO_LLM_MAX_TOKENS=72

# === 起動済みローカルモデル ===
# 生成を使わない確認は DOGIDO_LLM_ENABLED=false または DOGIDO_LLM_BACKEND=noop。
DOGIDO_LLM_BACKEND=chat_completions
DOGIDO_LLM_BASE_URL=http://127.0.0.1:8080/v1
DOGIDO_LLM_MODEL=default_model
DOGIDO_LLM_API_KEY=

# === ルート別（chat=雑談/助言、haiku=川柳）===
# 未指定キーは共通設定を継承。同じMac上の別endpoint・モデルも指定できる。
# DOGIDO_LLM_CHAT_BASE_URL=http://127.0.0.1:8080/v1
# DOGIDO_LLM_CHAT_MODEL=default_model
# DOGIDO_LLM_CHAT_API_KEY=
# DOGIDO_LLM_CHAT_MAX_TOKENS=512
# DOGIDO_LLM_CHAT_TIMEOUT_SEC=60
#
# DOGIDO_LLM_HAIKU_BASE_URL=http://127.0.0.1:8081/v1
# DOGIDO_LLM_HAIKU_MODEL=default_model
# DOGIDO_LLM_HAIKU_API_KEY=
# DOGIDO_LLM_HAIKU_MAX_TOKENS=256

# 共有endpointへ両routeを固定する場合は .env.shared.example と
# docs/shared-llm-profile.md を使う。

# 独自Minecraft gameDirのときだけ指定。未設定ならOS標準screenshotsを参照し、画像は移動しない。
# DOGIDO_MINECRAFT_SCREENSHOTS_DIR=

# 通常会話へドギド視点192px画像を一枚添える（画像対応chatモデルを使用）
DOGIDO_CHAT_IMAGE_ENABLED=false
DOGIDO_CHAT_IMAGE_STOP_REACTIONS_ENABLED=true
DOGIDO_CHAT_IMAGE_WAIT_MS=2500

# === 川柳8分類と通常16分類のModernBERT ===
# git lfs pull と pip install -e ".[request-classifier]" で準備する。
DOGIDO_REQUEST_CLASSIFIER_SENRYU_MODEL_ROOT=models/dogido-senryu424-seed42
# 通常16分類は学習済みモデルの準備後だけ指定する。未指定時に旧23分類へ戻さない。
# DOGIDO_REQUEST_CLASSIFIER_NORMAL_MODEL_ROOT=path/to/normal16-model
DOGIDO_REQUEST_CLASSIFIER_PYTHON=.venv/bin/python
