            "web_consent_requested"
          ]
        },
        {
          "text": "ええで",
          "expect_status": [
            "web_waiting_playback"
          ]
        },
        {
          "control": "speech_completed",
          "expect_status": [
            "reference_only"
          ],
          "expect_web_read": true
        },
        {
          "text": "わくわくは、むねがワクワクって鳴る音のことなんだね。",
          "expect_status": [
            "research_reflection"
          ],
          "expect_context": true
        },
        {
          "text": "うーん、気持ちと音って言われても、まだモヤっとするな。",
          "expect_status": [
            "return_offered"
          ]
        },
        {
          "text": "うん、先生にも聞いてみる。そろそろ冒険に戻ろう。",
          "expect_status": [
            "handoff"
          ],
          "expect_mode": "normal"
        }
      ]
    },
    {
