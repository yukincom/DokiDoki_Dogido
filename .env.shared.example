# 別に起動した共有 mlx-lm endpoint へ接続するための上書き設定。
# .env を先に読み、このファイルが LLM の接続先だけを上書きする。
# 8080 の起動・停止・モデル選択はドギド側では行わない。
DOGIDO_LLM_ENABLED=true
DOGIDO_LLM_BACKEND=chat_completions
DOGIDO_LLM_PROVIDER=local
DOGIDO_LLM_BASE_URL=http://127.0.0.1:8080/v1
DOGIDO_LLM_MODEL=default_model
DOGIDO_LLM_API_KEY=

# .env にルート別の設定が残っていても、chat と haiku を同じ共有モデルへ固定する。
DOGIDO_LLM_CHAT_BACKEND=chat_completions
DOGIDO_LLM_CHAT_PROVIDER=local
DOGIDO_LLM_CHAT_BASE_URL=http://127.0.0.1:8080/v1
DOGIDO_LLM_CHAT_MODEL=default_model
DOGIDO_LLM_CHAT_API_KEY=

DOGIDO_LLM_HAIKU_BACKEND=chat_completions
DOGIDO_LLM_HAIKU_PROVIDER=local
DOGIDO_LLM_HAIKU_BASE_URL=http://127.0.0.1:8080/v1
DOGIDO_LLM_HAIKU_MODEL=default_model
DOGIDO_LLM_HAIKU_API_KEY=

# 戦闘中断中の小分類も chat route を使い、別モデルをロードしない。
DOGIDO_PLATFORM_AI_PROVIDER=chat
