  "intermediate_size": 1024,
  "label2id": {
    "not_target": 0,
    "senryu_change_lower": 6,
    "senryu_change_middle": 5,
    "senryu_change_upper": 4,
    "senryu_end": 7,
    "senryu_line_lower": 3,
    "senryu_line_middle": 2,
    "senryu_line_upper": 1
