+                '<p style="animation:reveal 20s infinite">生成途中</p>')
+    result=extract(browser_ws,html)
+    assert result["complete"] is True and result["busy"]
+
+
+def test_answer_subtree_excludes_overview_footer_and_reference_cards(browser_ws):
