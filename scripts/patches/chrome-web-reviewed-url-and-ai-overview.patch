+    html+='<div data-text-ad><a href="https://example.com/ad"><h3>広告</h3></a></div></div>'
+    result=extract(browser_ws,html)
+    assert not result["found"] and not result["text"]
+    assert result["web"] == [{"title": "参考ページ", "url": "https://example.com/article", "description": "内容の紹介"}]
