+@pytest.mark.parametrize("outcome", ["complete", "not_found", "cancel", "redirect"])
+def test_fetch_wait_activation_cleanup_and_no_second_extraction(monkeypatch, outcome):
+    from chrome_web_mcp import google_overview
+    url = "https://www.google.com/search?q=test"
+    events = []
+
+    class Connection:
+        async def close(self):
+            events.append("socket_closed")
+
+    async def connect(*args, **kwargs):
+        return Connection()
+
+    async def cdp(conn, method, params=None):
+        events.append(method)
+        return {"targetId": "owned-tab"} if method == "Target.createTarget" else {}
+
+    async def evaluate(conn, expression):
+        if expression == "location.href":
+            return "https://example.com/" if outcome == "redirect" else url
+        assert expression == google_overview.OVERVIEW_SNAPSHOT_JS
+        return {"url": "https://example.com/" if outcome == "redirect" else url, "page_text": ""}
+
+    async def ready(conn):
+        pass
+
+    async def wait(read, **kwargs):
+        assert "Target.activateTarget" in events
+        if outcome == "cancel":
+            raise asyncio.CancelledError
+        return {"status": outcome, "text": "本文" if outcome == "complete" else "", "links": []}
+
+    runtime = server.BrowserRuntime()
+    runtime.display_mode, runtime.port = "native", 1
+    monkeypatch.setattr(server, "_RUNTIME", runtime)
+    monkeypatch.setattr(runtime, "ensure", lambda: "ws://localhost/browser")
+    monkeypatch.setattr(server, "_ENSURE_LOCK", asyncio.Lock())
+    monkeypatch.setattr(server.websockets, "connect", connect)
+    monkeypatch.setattr(server, "_cdp_call", cdp)
+    monkeypatch.setattr(server, "_evaluate", evaluate)
+    monkeypatch.setattr(server, "_wait_ready", ready)
+    monkeypatch.setattr(server, "_validate_public_url", lambda u: u)
+    monkeypatch.setattr(google_overview, "wait_for_overview", wait)
+    monkeypatch.setattr(server, "_read_page_string", lambda *a: pytest.fail("extra page extraction"))
+    coroutine = server._fetch_page(url, 500, expected_url=url, wait_for_ai_overview=True)
+    if outcome in {"cancel", "redirect"}:
+        with pytest.raises(asyncio.CancelledError if outcome == "cancel" else ValueError):
+            asyncio.run(coroutine)
+        assert "Target.closeTarget" in events
+        if outcome == "redirect":
+            assert "Target.activateTarget" not in events
+    else:
+        result = asyncio.run(coroutine)
+        assert result["ai_overview"]["status"] == outcome
+        assert result["expected_url_verified"] is True
+        assert "text" not in result and "markdown" not in result
+    assert events.count("socket_closed") == 2
