+"""Run the actual extractor in owned headless Chrome on synthetic HTML only."""
+import asyncio
+import json
+
+import pytest
+import websockets
+
+from chrome_web_mcp import server
+from chrome_web_mcp.google_overview import OVERVIEW_SNAPSHOT_JS
+
+
+@pytest.fixture(scope="module")
+def browser_ws():
+    runtime = server.BrowserRuntime()
+    runtime.display_mode = "headless"
+    try:
+        yield runtime.ensure()
+    finally:
+        runtime.cleanup()
+
+
+def extract(browser_ws, html):
+    async def run():
+        async with websockets.connect(browser_ws, max_size=server.MAX_CDP_MESSAGE) as browser:
+            result = await server._cdp_call(browser, "Target.createTarget", {"url": "about:blank"})
+            target = result["targetId"]
+            attached = await server._cdp_call(browser, "Target.attachToTarget", {"targetId": target, "flatten": True})
+            session = attached["sessionId"]
+            async def evaluate(expression):
+                # A browser socket with a flattened target session; no navigation.
+                rid = next(server._CDP_IDS)
+                await browser.send(json.dumps({"id":rid,"sessionId":session,"method":"Runtime.evaluate",
+                                               "params":{"expression":expression,"returnByValue":True}}))
+                while True:
+                    response=json.loads(await asyncio.wait_for(browser.recv(), 10))
+                    if response.get("id")==rid:
+                        assert "error" not in response and "exceptionDetails" not in response.get("result", {})
+                        return response["result"]["result"].get("value")
+            try:
+                await evaluate("document.body.innerHTML=" + json.dumps(html))
+                return await evaluate(OVERVIEW_SNAPSHOT_JS)
+            finally:
+                await server._cdp_call(browser, "Target.closeTarget", {"targetId":target})
+    return asyncio.run(run())
+
+
+def region(body, marker="true"):
+    return ('<div id="m-x-content"><div data-rao data-complete="'+marker+'"></div>'
+            '<div role="heading" aria-level="2">AI による概要</div>'+body+'</div>')
+
+
+def test_actual_js_excludes_hidden_failures_and_controls(browser_ws):
+    html=region('<span style="display:none">現在、AI による概要を生成できません</span>'
+                '<p>金床の説明です。</p><ul><li>金の読み方</li><li>床の意味</li></ul>'
+                '<button>共有メニュー</button><div role="dialog">共有リンクの注意事項</div>'
+                '<a href="https://example.com/reference">出典</a>')
+    result=extract(browser_ws,html+'<h3>ウェブ検索結果</h3><p>広告や別の検索結果</p>')
+    assert result["found"] and result["complete"] and not result["unavailable"]
+    assert "金床の説明です。" in result["text"] and "床の意味" in result["text"]
+    assert all(t not in result["text"] for t in ["共有", "生成できません", "広告", "ウェブ検索結果"])
+    assert result["links"]==[{"title":"出典","url":"https://example.com/reference"}]
+
+
+def test_search_result_heading_is_not_an_overview(browser_ws):
+    result=extract(browser_ws,'<h3>AI による概要</h3><p>通常の検索結果の紹介文</p>')
+    assert not result["found"] and not result["text"]
+
+
+def test_hidden_region_is_not_read(browser_ws):
+    result=extract(browser_ws,'<div hidden>'+region('<p>非表示の本文</p>')+'</div>')
+    assert not result["found"]
+
+
+def test_generating_marker_is_not_complete(browser_ws):
