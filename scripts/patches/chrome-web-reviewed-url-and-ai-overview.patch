diff --git a/src/chrome_web_mcp/google_overview.py b/src/chrome_web_mcp/google_overview.py
new file mode 100644
--- /dev/null
+++ b/src/chrome_web_mcp/google_overview.py
@@ -0,0 +1,140 @@
+"""Read a rendered Google AI Overview without treating the SERP as the answer."""
+
+import asyncio
+import time
+from urllib.parse import parse_qs, urlsplit
+
+
+def is_standard_google_search(url: str) -> bool:
+    from .server import _is_google_host
+
+    parsed = urlsplit(url)
+    query = parse_qs(parsed.query)
+    return (parsed.scheme == "https" and _is_google_host(parsed.hostname)
+            and parsed.path == "/search" and bool(query.get("q"))
+            and not query.get("udm") and not query.get("tbm"))
+
+
+# The heading, m-x-content region and data-rao completion marker were observed
+# together on Google's rendered Japanese search page. Unknown layouts are not
+# replaced with the entire search results body.
+OVERVIEW_SNAPSHOT_JS = r"""(() => {
+ const visible = e => {
+   if (!e || e.closest('[hidden]')) return false;
+   for (let p=e; p; p=p.parentElement) {
+     // Google marks the folded answer tail with ahbak, without display:none.
+     // Read that answer too, but not hidden dialogs or error placeholders.
+     if(p.getAttribute('aria-hidden')==='true' && p.getAttribute('ahbak')!=='true') return false;
+     const s=getComputedStyle(p);
+     if(s.display==='none'||s.visibility==='hidden'||s.visibility==='collapse') return false;
+   }
+   return e.getClientRects().length>0 || getComputedStyle(e).display==='contents';
+ };
+ const pageText = (document.body?.innerText || '').slice(0,2500);
+ const result = {url:location.href, page_text:pageText, visibility:document.visibilityState, found:false,
+   text:'', links:[], web:[], busy:false, complete:null, unavailable:false};
+ // Preserve ordinary results from this same page for a child-led follow-up.
+ // No extra search, redirect resolution or link fetch happens here.
+ const seen=new Set();
+ for(const a of document.querySelectorAll('#rso a[href]')) {
+   if(a.closest('#m-x-content,[data-text-ad],[data-ta-slot]')) continue;
+   const h=a.querySelector('h3');
+   if(!h || !visible(h)) continue;
+   const title=h.innerText.trim(), url=a.href;
+   if(!title || !/^https?:\/\//.test(url) || seen.has(url)) continue;
+   const block=a.closest('[data-hveid]') || a.parentElement;
+   let description=(block?.innerText || '').replace(/\s+/g,' ').trim();
+   if(description.startsWith(title)) description=description.slice(title.length).trim();
+   result.web.push({title:title.slice(0,300),url,description:description.slice(0,1000)});
+   seen.add(url);
+   if(result.web.length>=5) break;
+ }
+ const root = document.querySelector('#m-x-content');
+ if(!root) return result;
+ const headings=[...root.querySelectorAll('h1,h2,h3,[role="heading"]')];
+ const heading=headings.find(e=>visible(e)&&/^(AI による概要|AI Overview)$/i.test(e.innerText.trim()));
+ if(!heading) return result;
+ result.found=true;
+ const marker=root.querySelector('[data-rao][data-complete]');
+ if(marker) result.complete=marker.getAttribute('data-complete')==='true';
+ result.busy=result.complete===false || [...root.querySelectorAll('[aria-busy="true"],[role="progressbar"]')].some(visible);
+ // data-complete is set before the streamed answer finishes revealing itself.
+ // The observed reveal/loading animations continue until that rendering ends.
+ result.busy=result.busy || root.getAnimations({subtree:true}).some(a=>
+   a.playState==='running' && visible(a.effect?.target));
+ const skip='script,style,noscript,svg,canvas,nav,footer,header,button,input,textarea,select,[role="button"],[role="dialog"],[role="toolbar"]';
+ const walk = node => {
+   if(node.nodeType===Node.TEXT_NODE) return node.textContent;
+   if(node.nodeType!==Node.ELEMENT_NODE || node===heading || node.matches(skip) || !visible(node)) return '';
+   const text=[...node.childNodes].map(walk).join('');
+   return /^(block|flex|grid|list-item|table.*)$/.test(getComputedStyle(node).display) ? '\n'+text+'\n' : text;
+ };
+ const answer=root.querySelector('[data-subtree="aimc"]') || root;
+ const text=walk(answer).split('\n').map(s=>s.replace(/\s+/g,' ').trim()).filter(Boolean).join('\n');
+ result.unavailable=/この検索では AI による概要を表示できません|現在、AI による概要を生成できません|AI overview is not available|Can't generate an AI overview/i.test(text);
+ result.busy=result.busy || /^(処理しています|生成しています|Generating|Thinking|Loading)[.…。\s]*$/im.test(text);
+ result.text=result.unavailable?'':text;
+ result.links=[...root.querySelectorAll('a[href]')].filter(a=>visible(a)&&!a.closest(skip))
+   .map(a=>({title:a.innerText.trim(),url:a.href})).filter(a=>/^https?:\/\//.test(a.url)).slice(0,40);
+ return result;
+})()"""
+
+
+async def wait_for_overview(read_snapshot, *, started=None, clock=time.monotonic,
+                            sleep=asyncio.sleep):
+    """Poll the same page at 4, 4.5 and 5 seconds from the fetch start, then stop.
+
+    A marker alone precedes streaming: require no loading animation and equal
+    text in two consecutive samples. No second fetch or automatic new search.
+    The final DOM read has at most 250ms; failure has no answer/error sentence.
+    """
+    started = clock() if started is None else started
+    deadline = started + 5.25
+    last = {}
+    samples = 0
+    seen = False
+    settled_text = None
+    settled_since = started
+
+    def finish(status, *, reason=""):
+        text = last.get("text", "")
+        complete = status == "complete"
+        return {
+            "status": status, "text": text if complete else "",
+            "links": last.get("links", []) if complete else [],
+            "web": last.get("web", []) if status in {"complete", "not_found", "unavailable", "timeout"} else [],
+            "waited_ms": round((clock() - started) * 1000), "samples": samples,
+            "completion_signal": reason,
+            "page_visibility": last.get("visibility", "unknown"),
+        }
+
+    for poll_at in (4.0, 4.5, 5.0):
+        if clock() >= deadline:
+            break
+        await sleep(max(0.0, started + poll_at - clock()))
+        try:
+            snapshot = await asyncio.wait_for(read_snapshot(), min(.25, max(0.0, deadline - clock())))
+        except asyncio.TimeoutError:
+            return finish("timeout", reason="snapshot_timeout")
+        samples += 1
+        last = snapshot
+        if snapshot.get("challenge"):
+            return finish("challenge")
+        if snapshot.get("navigation_changed"):
+            return finish("navigation_changed")
+        if snapshot.get("unavailable") and not snapshot.get("busy"):
+            return finish("unavailable")
+        seen = seen or bool(snapshot.get("found"))
+        text = snapshot.get("text", "").strip()
+        eligible = snapshot.get("found") and bool(text) and not snapshot.get("busy") and not snapshot.get("unavailable")
+        if eligible and snapshot.get("complete") is True:
+            if text != settled_text:
+                settled_text = text
+                settled_since = clock()
+            elif clock() - settled_since >= .4:
+                return finish("complete", reason="render_settled")
+        else:
+            settled_text = None
+    if last.get("unavailable"):
+        return finish("unavailable")
+    return finish("timeout" if seen else "not_found")
diff --git a/tests/test_google_overview.py b/tests/test_google_overview.py
new file mode 100644
--- /dev/null
+++ b/tests/test_google_overview.py
@@ -0,0 +1,235 @@
+import asyncio
+import json
+
+import pytest
+
+from chrome_web_mcp.google_overview import is_standard_google_search, wait_for_overview
+from chrome_web_mcp import server
+
+
+def snapshot(text="", *, found=True, complete=False, busy=False, **extra):
+    return dict(found=found, text=text, complete=complete, busy=busy, links=[], **extra)
+
+
+def wait_sequence(frames):
+    now = [0.0]
+    calls = []
+
+    async def read():
+        frame = frames[min(len(calls), len(frames)-1)]
+        calls.append(frame)
+        return frame
+
+    async def sleep(delay):
+        now[0] += delay
+
+    result = asyncio.run(wait_for_overview(read, clock=lambda: now[0], sleep=sleep))
+    return result, calls
+
+
+def test_delayed_generation_returns_only_completed_snapshot():
+    frames = [snapshot(found=False), snapshot("完成した本文", complete=True)]
+    result, calls = wait_sequence(frames)
+    assert result["status"] == "complete"
+    assert result["text"] == "完成した本文"
+    assert result["samples"] == len(calls) == 3
+    assert result["waited_ms"] == 5000
+    assert result["completion_signal"] == "render_settled"
+
+
+def test_ready_answer_only_waits_for_render_to_settle():
+    result, calls = wait_sequence([snapshot("本文", complete=True)])
+    assert result["text"] == "本文"
+    assert len(calls) == 2 and result["waited_ms"] == 4500
+
+
+def test_no_overview_keeps_search_results_after_only_three_polls():
+    web = [{"title": "参考ページ", "url": "https://example.com/", "description": "紹介文"}]
+    result, calls = wait_sequence([snapshot(found=False, web=web)])
+    assert result["status"] == "not_found" and result["text"] == ""
+    assert result["web"] == web and len(calls) == 3 and result["waited_ms"] == 5000
+
+
+def test_late_browser_start_does_not_turn_immediate_reads_into_settled_text():
+    async def read():
+        return snapshot("まだ途中かもしれない", complete=True)
+    result = asyncio.run(wait_for_overview(read, started=0, clock=lambda: 4.9,
+                                          sleep=lambda _: asyncio.sleep(0)))
+    assert result["status"] == "timeout" and result["samples"] == 3
+
+
+def test_marker_does_not_end_stream_early_and_same_length_rewrite_resets_wait():
+    frames = [snapshot("冒頭", complete=True), snapshot("本文", complete=True),
+              snapshot("全文", complete=True)]
+    result, calls = wait_sequence(frames)
+    assert result["status"] == "timeout" and not result["text"] and len(calls) == 3
+
+
