@@ -80,22 +80,41 @@ OVERVIEW_SNAPSHOT_JS = r"""(() => {
 })()"""
 
 
+# One CDP evaluation, with a local DOM quiet-window check. Neither snapshot nor
+# the MutationObserver sends a Google query, navigates, or fetches a resource.
+OVERVIEW_SETTLED_SNAPSHOT_JS = r"""(async () => {
+ const snapshot = () => (""" + OVERVIEW_SNAPSHOT_JS + r""");
+ const before = snapshot();
+ const eligible = s => s.found && s.complete === true && !s.busy && !s.unavailable && s.text.trim();
+ if (!eligible(before)) return {...before, render_settled:false};
+ const root = document.querySelector('#m-x-content');
+ let changed = false;
+ const observer = new MutationObserver(() => { changed = true; });
+ observer.observe(root, {subtree:true, childList:true, characterData:true, attributes:true});
+ try {
+   await new Promise(resolve => setTimeout(resolve, 400));
+   const after = snapshot();
+   return {...after, render_settled:!changed && !!eligible(after)
+     && root.isConnected && root === document.querySelector('#m-x-content')
+     && before.url === after.url && before.text === after.text};
+ } finally { observer.disconnect(); }
+})()"""
+
