+@pytest.mark.parametrize("outcome", ["complete", "changed", "changed_late", "closed", "cancel"])
+def test_existing_tab_is_read_only_never_reopened_or_activated(monkeypatch, outcome):
+    from chrome_web_mcp import google_overview
+    url = "https://www.google.com/search?q=test"
+    tab_id = "A" * 32
+    events = []
+    reads = []
+
+    class Connection:
+        async def close(self):
+            events.append("socket_closed")
+
+    async def connect(*args, **kwargs):
+        return Connection()
+
+    async def cdp(conn, method, params=None):
+        events.append(method)
+        if method == "Target.getTargetInfo":
+            assert params == {"targetId": tab_id}
+            if outcome == "closed":
+                raise RuntimeError("No such target")
+            return {"targetInfo": {"url": "https://www.google.com/search?q=other" if outcome == "changed" else url}}
+        assert method in {"Page.enable", "Runtime.enable"}
+        return {}
+
+    async def evaluate(conn, expression):
+        assert expression == "location.href"
+        reads.append(expression)
+        if outcome == "changed_late" and len(reads) > 1:
+            return "https://www.google.com/search?q=other"
+        return url
+
+    async def wait(read, **kwargs):
+        assert kwargs["reread"] is True
+        if outcome == "cancel":
+            raise asyncio.CancelledError
+        return {"status": "complete", "text": "完成した概要", "links": []}
+
+    runtime = server.BrowserRuntime()
+    runtime.display_mode, runtime.port, runtime.browser_ws = "native", 1, "ws://localhost/browser"
+    monkeypatch.setattr(server, "_RUNTIME", runtime)
+    monkeypatch.setattr(runtime, "ensure", lambda: pytest.fail("must not restart Chrome"))
+    monkeypatch.setattr(server, "_ENSURE_LOCK", asyncio.Lock())
+    monkeypatch.setattr(server.websockets, "connect", connect)
+    monkeypatch.setattr(server, "_cdp_call", cdp)
+    monkeypatch.setattr(server, "_evaluate", evaluate)
+    monkeypatch.setattr(server, "_validate_public_url", lambda u: u)
+    monkeypatch.setattr(google_overview, "wait_for_overview", wait)
+    call = server._fetch_page(url, 500, wait_for_ai_overview=True, existing_tab_id=tab_id)
+    if outcome == "complete":
+        result = asyncio.run(call)
+        assert result["tab_id"] == tab_id and result["ai_overview"]["text"] == "完成した概要"
+    else:
+        with pytest.raises({"changed": ValueError, "changed_late": ValueError, "closed": RuntimeError, "cancel": asyncio.CancelledError}[outcome]):
+            asyncio.run(call)
+    assert not ({"Target.createTarget", "Page.navigate", "Target.activateTarget", "Target.closeTarget"} & set(events))
+    assert events.count("socket_closed") == (1 if outcome in {"changed", "closed"} else 2)
+
+
+@pytest.mark.parametrize("arguments", [
+    {"existing_tab_id": "A" * 32},
+    {"existing_tab_id": "invalid", "wait_for_ai_overview": True},
+    {"existing_tab_id": True, "wait_for_ai_overview": True},
+])
+def test_existing_tab_validation_precedes_browser(monkeypatch, arguments):
+    async def forbidden(*args, **kwargs):
+        pytest.fail("browser invoked")
+    monkeypatch.setattr(server, "_fetch_page", forbidden)
+    result = asyncio.run(server.call_tool("fetch_url", {"url": "https://www.google.com/search?q=test", **arguments}))
+    assert not json.loads(result[0].text)["success"]
+
+
+def test_not_yet_readable_search_keeps_tab_identity_not_error_body(monkeypatch):
+    url, tab_id = "https://www.google.com/search?q=test", "A" * 32
+    async def fetch(*args, **kwargs):
+        return {"final_url": url, "tab_id": tab_id, "text": "生成途中の本文",
+                "ai_overview": {"status": "timeout", "text": "", "page_visibility": "visible"}, "web": []}
+    monkeypatch.setattr(server, "_fetch_page", fetch)
+    result = asyncio.run(server.call_tool("fetch_url", {"url": url, "wait_for_ai_overview": True}))
+    payload = json.loads(result[0].text)
+    assert payload["success"] is False and payload["data"]["tab_id"] == tab_id
+    assert payload["data"]["final_url"] == url and "生成途中" not in str(payload)
